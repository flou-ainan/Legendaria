{
  "$comment": "LLM providers for the caption reviewer (plan 03, layer 3). Any OpenAI-compatible chat server works. Keys are read from the environment variable named in api_key_env, never stored in files. Add your own entries in <config dir>/providers.json.",
  "version": 1,
  "providers": {
    "ollama": {"base_url": "http://127.0.0.1:11434/v1", "api_key_env": "", "local": true, "notes": "Ollama (ollama.com). Models are freed from GPU memory after the review."},
    "lmstudio": {"base_url": "http://127.0.0.1:1234/v1", "api_key_env": "", "local": true, "notes": "LM Studio local server."},
    "llamacpp": {"base_url": "http://127.0.0.1:8080/v1", "api_key_env": "", "local": true, "notes": "llama.cpp server (llama-server)."},
    "openai": {"base_url": "https://api.openai.com/v1", "api_key_env": "OPENAI_API_KEY", "local": false, "notes": "OpenAI (cloud, paid)."},
    "gemini": {"base_url": "https://generativelanguage.googleapis.com/v1beta/openai", "api_key_env": "GEMINI_API_KEY", "local": false, "notes": "Google Gemini, OpenAI-compatible endpoint (cloud)."},
    "anthropic": {"base_url": "https://api.anthropic.com/v1", "api_key_env": "ANTHROPIC_API_KEY", "local": false, "notes": "Anthropic Claude, OpenAI-compatible endpoint (cloud)."},
    "openrouter": {"base_url": "https://openrouter.ai/api/v1", "api_key_env": "OPENROUTER_API_KEY", "local": false, "notes": "OpenRouter (many cloud models)."}
  }
}
