{
  "$schema": "https://raw.githubusercontent.com/flou-ainan/Legendaria/main/engine/schemas/config.schema.json",
  "version": 1,
  "model": "small",
  "language": "auto",
  "device": "auto",
  "compute_type": {
    "cuda": "float16",
    "cpu": "int8"
  },
  "beam_size": 5,
  "vad_filter": true,
  "word_timestamps": true,
  "style": "subtitles",
  "styles": {
    "subtitles": {
      "max_chars": 84,
      "line_length": 42,
      "max_duration": 6.0,
      "min_duration": 1.0,
      "pause_break": 1.0,
      "break_after": ".!?…",
      "break_on_segment": true
    },
    "captions": {
      "max_words": 4,
      "max_chars": 22,
      "max_duration": 2.2,
      "min_duration": 0.3,
      "pause_break": 0.5,
      "break_after": ".,!?;:…",
      "break_on_segment": true
    }
  },
  "formats": [
    "json",
    "srt",
    "vtt"
  ],
  "ui_languages": [
    "auto",
    "pt",
    "en"
  ]
}
