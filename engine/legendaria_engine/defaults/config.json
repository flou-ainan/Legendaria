{
  "$schema": "https://raw.githubusercontent.com/flou-ainan/Legendaria/main/engine/schemas/config.schema.json",
  "version": 1,
  "model": "small",
  "language": "auto",
  "device": "auto",
  "compute_type": {
    "cuda": "float16",
    "cpu": "int8"
  },
  "beam_size": 5,
  "vad_filter": true,
  "word_timestamps": true,
  "style": "subtitles",
  "styles": {
    "pop": {
      "max_words": 1,
      "join_short": 3,
      "max_chars": 24,
      "max_duration": 1.6,
      "min_duration": 0.25,
      "pause_break": 0.6,
      "fill_gaps": 0.35,
      "break_after": ".,!?;:…",
      "break_on_segment": true
    },
    "subtitles": {
      "max_chars": 84,
      "line_length": 42,
      "max_duration": 6.0,
      "min_duration": 1.0,
      "pause_break": 1.0,
      "break_after": ".!?…",
      "break_on_segment": true
    },
    "captions": {
      "max_words": 4,
      "max_chars": 22,
      "max_duration": 2.2,
      "min_duration": 0.3,
      "pause_break": 0.5,
      "break_after": ".,!?;:…",
      "break_on_segment": true
    }
  },
  "formats": [
    "json",
    "srt",
    "vtt"
  ],
  "ui_languages": [
    "auto",
    "pt",
    "en"
  ],
  "review": {
    "glossary": "default",
    "mode": "suggest",
    "glossary_bias": true,
    "fuzzy_threshold": 0.82,
    "low_confidence": 0.5,
    "profile": "auto",
    "llm": {
      "enabled": "auto",
      "provider": "ollama",
      "base_url": "",
      "model": "",
      "api_key_env": "",
      "batch_lines": 20,
      "context_lines": 2,
      "max_change_ratio": 0.35,
      "timeout_s": 180,
      "unload_after": true
    }
  }
}
