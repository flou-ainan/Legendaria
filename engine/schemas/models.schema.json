{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/flou-ainan/Legendaria/main/engine/schemas/models.schema.json",
  "title": "Legendária model catalog",
  "description": "Whisper models available for download. A user models.json can add models or change entries.",
  "type": "object",
  "required": ["models"],
  "properties": {
    "$schema": {"type": "string"},
    "version": {"const": 1},
    "models": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["repo"],
        "properties": {
          "repo": {"type": "string", "description": "Hugging Face repository with a CTranslate2 (faster-whisper) model."},
          "size_mb": {"type": "integer", "minimum": 1},
          "vram_mb": {"type": "integer", "minimum": 1, "description": "Approximate GPU memory needed."},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
